# MIMO_API_KEY required for TTS voice output
# Get at: https://platform.xiaomimimo.com/
MIMO_API_KEY=your_mimo_api_key_here
MIMO_TTS_VOICE=冰糖

# LLM provider (OpenCode Zen; free model mimo-v2.5-free)
# Get OpenCode API key at: https://opencode.ai/auth
AOI_PROVIDER=opencode
# AOI_MODEL=mimo-v2.5-free
OPENCODE_API_KEY=your_opencode_api_key_here

# Anthropic API Key (optional fallback provider)
# ANTHROPIC_API_KEY=sk-ant-...

# Simultaneous interpretation target language (default: 中文)
# INTERP_TARGET_LANG=中文

# TUI output mode: push replies to the jarvis-vr-tui ANSI terminal
# AOI_TUI=1

# Sherpa-ONNX model dir (optional, requires AOI_ENABLE_SHERPA build)
# SHERPA_ASR_MODEL=models/sherpa/sherpa-onnx-streaming-zipformer-small-bilingual-zh-en-2023-02-16
# SHERPA_VAD_MODEL=models/sherpa/silero_vad.onnx
# AOI_FRAMES_DIR=context/frames
